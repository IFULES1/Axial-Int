# ==========================================================================
# Axial Intelligence — configuration (copy to .env and fill in)
# NEVER commit the real .env. Secrets stay out of the repo.
# ==========================================================================

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=120

# --- App database ---
DATABASE_URL=postgresql+psycopg://axial:axial@localhost:5432/axial
# Pool de connexions (PostgreSQL seulement). CHAQUE génération suivie en occupe
# deux pendant toute sa durée — le générateur SSE et le moteur — donc le défaut
# de SQLAlchemy (5 + 10) tombait à sept rapports simultanés. 10 + 20 = trente
# connexions, soit quinze générations concurrentes. À relever seulement si la
# base l'accepte (côté Supabase, le pooler a sa propre limite).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Auth (Supabase APP project) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
REQUIRE_INVITATION_CODE=false
ALLOW_FREEMAIL=false

# --- Analytics (separate Supabase ANALYTICS project) ---
ANALYTICS_DATABASE_URL=
ANALYTICS_ENABLED=true

# --- LLM / providers ---
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL_CHAT=sonar
PERPLEXITY_MODEL_ANALYSIS=sonar-pro
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
CLAUDE_ENRICHMENT_ENABLED=false
CLAUDE_ENRICHMENT_MODEL=claude-sonnet-5
PAPPERS_API_KEY=
SERPER_API_KEY=

# --- PII sidecar ---
PRESIDIO_URL=http://localhost:8010
PII_GUARD_MODE=shadow
PII_MAPPING_KEY=

# --- Tarifs des fournisseurs de recherche web ---
# Micro-euros par appel (1 € = 1 000 000 µ€). Ordres de grandeur au 25/08/2026,
# à confirmer sur les grilles officielles avant toute décision de prix.
TARIF_RECHERCHE_EXA_MICRO_EUR=4600
TARIF_RECHERCHE_TAVILY_MICRO_EUR=7400
TARIF_RECHERCHE_LINKUP_MICRO_EUR=4600
TARIF_RECHERCHE_SERPER_MICRO_EUR=920
TARIF_RECHERCHE_DEFAUT_MICRO_EUR=4600

# --- Google OAuth (livraison d'un rapport dans Google Drive) ---
# Sans ces deux valeurs, la tuile « Dans Google Drive » n'apparaît pas : le
# backend déclare le fournisseur non configuré et le front n'offre rien.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (worker) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@axial.com

# --- Notification d'erreur backend ---
ERREURS_NOTIF_ACTIVES=true
ERREURS_NOTIF_DESTINATAIRE=miradie.buranturu@axial-ia.fr

# --- Front Next.js (fichier frontend/.env.local sur le VPS) ---
# Rappel : ces deux variables se posent côté FRONT, pas ici. Elles figurent
# dans ce fichier pour que la procédure de déploiement soit complète.
#   NEXT_PUBLIC_API_URL=https://app.axial-ia.fr/api
#     URL PUBLIQUE, figée à la compilation. Elle sert au navigateur du
#     visiteur — y compris pour les <img> des graphiques d'une page partagée.
#   API_INTERNE_URL=http://127.0.0.1:8090
#     URL SERVEUR, lue à l'exécution par le rendu SSR de /p/<pseudo>/<slug>.
#     Sans elle, le VPS faisait un aller-retour DNS + TLS + proxy vers son
#     propre nom public à chaque affichage d'un rapport partagé, et la page
#     cassait si le certificat ou le reverse proxy avait un souci.
API_INTERNE_URL=http://127.0.0.1:8090
