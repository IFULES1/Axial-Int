# ==========================================================================
# Axial Intelligence — configuration (copy to .env and fill in)
# NEVER commit the real .env. Secrets stay out of the repo.
# ==========================================================================

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=120

# --- App database ---
DATABASE_URL=postgresql+psycopg://axial:axial@localhost:5432/axial

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Auth (Supabase APP project) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
REQUIRE_INVITATION_CODE=false
ALLOW_FREEMAIL=false

# --- Analytics (separate Supabase ANALYTICS project) ---
ANALYTICS_DATABASE_URL=
ANALYTICS_ENABLED=true

# --- LLM / providers ---
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL_CHAT=sonar
PERPLEXITY_MODEL_ANALYSIS=sonar-pro
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
CLAUDE_ENRICHMENT_ENABLED=false
CLAUDE_ENRICHMENT_MODEL=claude-sonnet-5
PAPPERS_API_KEY=
SERPER_API_KEY=

# --- PII sidecar ---
PRESIDIO_URL=http://localhost:8010
PII_GUARD_MODE=shadow
PII_MAPPING_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (worker) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@axial.com
